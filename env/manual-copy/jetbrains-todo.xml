<!-- 
This is config of my TODO tags in code for JetBrains IDEs
Content of this file should be copied into `~/.config/JetBrains/
{IDE}/.../editor.xml` file. It should replace existing TodoConfiguration section
If you don't have one - edit configuration from UI first

Important: Disable sync before adding this to not mess up anything
Enable auto-sync after with OVERWRITING REMOTE WITH LOCAL instead of overwriting 
local with remote, which will delete changes

This file should be in sync with neovim todo config
-->

<component name="TodoConfiguration">
	<multiLine>false</multiLine>
	<pattern useCustomColors="true" pattern="\s(todo)(\([^\)]*\))?:\s">
		<option name="FOREGROUND" value="ffffff" />
		<option name="BACKGROUND" value="2563eb" />
		<option name="FONT_TYPE" value="2" />
		<option name="ERROR_STRIPE_COLOR" value="2563eb" />
		<option name="EFFECT_TYPE" value="-1" />
	</pattern>
	<pattern useCustomColors="true" pattern="\s(fixme|bug|fixit|issue)(\([^\)]*\))?:\s">
		<option name="FOREGROUND" value="ffffff" />
